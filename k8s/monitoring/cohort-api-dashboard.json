{
  "title": "Cohort API Dashboard",
  "uid": "cohort-api-metrics",
  "timezone": "browser",
  "refresh": "10s",
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Total API Requests",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "targets": [{"expr": "sum(cohort_http_requests_total)", "legendFormat": "Total Requests", "datasource": {"type": "prometheus"}}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"steps": [{"color": "blue", "value": null}]}}}
    },
    {
      "id": 2, "type": "stat", "title": "Request Rate (req/s)",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "targets": [{"expr": "sum(rate(cohort_http_requests_total[1m]))", "legendFormat": "req/s", "datasource": {"type": "prometheus"}}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background"},
      "fieldConfig": {"defaults": {"decimals": 2, "color": {"mode": "thresholds"}, "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 10}, {"color": "red", "value": 50}]}}}
    },
    {
      "id": 3, "type": "stat", "title": "Error Rate (4xx/5xx)",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "targets": [{"expr": "sum(rate(cohort_http_requests_total{status_code=~\"4..|5..\"}[1m]))", "legendFormat": "Errors/s", "datasource": {"type": "prometheus"}}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background"},
      "fieldConfig": {"defaults": {"decimals": 2, "color": {"mode": "thresholds"}, "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.1}, {"color": "red", "value": 1}]}}}
    },
    {
      "id": 4, "type": "stat", "title": "Active WebSocket Connections",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "targets": [{"expr": "cohort_active_socket_connections", "legendFormat": "Connections", "datasource": {"type": "prometheus"}}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"steps": [{"color": "blue", "value": null}]}}}
    },
    {
      "id": 5, "type": "stat", "title": "MongoDB Status",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 4},
      "targets": [{"expr": "cohort_mongodb_connected", "legendFormat": "MongoDB", "datasource": {"type": "prometheus"}}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background"},
      "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "DISCONNECTED", "color": "red"}, "1": {"text": "CONNECTED", "color": "green"}}}], "color": {"mode": "thresholds"}, "thresholds": {"steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}}
    },
    {
      "id": 6, "type": "stat", "title": "Avg Response Time (ms)",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 4},
      "targets": [{"expr": "sum(rate(cohort_http_request_duration_seconds_sum[5m])) / sum(rate(cohort_http_request_duration_seconds_count[5m])) * 1000", "legendFormat": "Avg Latency", "datasource": {"type": "prometheus"}}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background"},
      "fieldConfig": {"defaults": {"decimals": 1, "unit": "ms", "color": {"mode": "thresholds"}, "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 200}, {"color": "red", "value": 1000}]}}}
    },
    {
      "id": 7, "type": "timeseries", "title": "HTTP Requests per Second by Route",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8},
      "targets": [{"expr": "sum by(route, method) (rate(cohort_http_requests_total[1m]))", "legendFormat": "{{method}} {{route}}", "datasource": {"type": "prometheus"}}],
      "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"lineWidth": 2}}}
    },
    {
      "id": 8, "type": "timeseries", "title": "Response Time by Route (p95)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "targets": [{"expr": "histogram_quantile(0.95, sum by(route, le) (rate(cohort_http_request_duration_seconds_bucket[5m]))) * 1000", "legendFormat": "p95 {{route}}", "datasource": {"type": "prometheus"}}],
      "fieldConfig": {"defaults": {"unit": "ms", "custom": {"lineWidth": 2}}}
    },
    {
      "id": 9, "type": "timeseries", "title": "Error Rate by Status Code",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "targets": [{"expr": "sum by(status_code) (rate(cohort_http_requests_total{status_code=~\"4..|5..\"}[1m]))", "legendFormat": "HTTP {{status_code}}", "datasource": {"type": "prometheus"}}],
      "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"lineWidth": 2}}}
    },
    {
      "id": 10, "type": "timeseries", "title": "Node.js Memory Usage",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
      "targets": [
        {"expr": "process_resident_memory_bytes{job=\"cohort-server\"}", "legendFormat": "RSS Memory", "datasource": {"type": "prometheus"}},
        {"expr": "nodejs_heap_size_used_bytes{job=\"cohort-server\"}", "legendFormat": "Heap Used", "datasource": {"type": "prometheus"}}
      ],
      "fieldConfig": {"defaults": {"unit": "bytes", "custom": {"lineWidth": 2}}}
    },
    {
      "id": 11, "type": "timeseries", "title": "Active WebSocket Connections Over Time",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
      "targets": [{"expr": "cohort_active_socket_connections", "legendFormat": "Active Connections", "datasource": {"type": "prometheus"}}],
      "fieldConfig": {"defaults": {"custom": {"lineWidth": 2, "fillOpacity": 20}}}
    }
  ],
  "time": {"from": "now-30m", "to": "now"},
  "schemaVersion": 36
}
